# Copy to `.env` to change defaults. Real environment variables take precedence.
# Every value below is the built-in default, so you only need this file to change something.

# Interface and port the web UI listens on. Keep it on localhost: the scanner can
# start scans from this machine, so it must not be reachable by other computers.
AYYSCANNER_HOST=127.0.0.1
AYYSCANNER_PORT=8765

# Open the UI in your browser on start (1 or 0)
AYYSCANNER_OPEN_BROWSER=1

# How many scans may run at the same time (1-10)
AYYSCANNER_MAX_CONCURRENT_SCANS=2

# DEBUG, INFO, WARNING or ERROR
AYYSCANNER_LOG_LEVEL=INFO

# Where finished scans are saved automatically. Default: ~/.ayyscanner/scans. Use "off" to disable saving.
# AYYSCANNER_DATA_DIR=

# Developer only: include exception details in API error responses (0 or 1)
AYYSCANNER_DEBUG=0

# Only if you deliberately expose the UI beyond localhost (not recommended; put it behind
# authentication such as a reverse proxy). Both settings are required together.
# AYYSCANNER_ALLOW_REMOTE=1
# AYYSCANNER_ALLOWED_HOSTS=scanner.internal.example
